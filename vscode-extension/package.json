{
  "name": "hot100-practice",
  "publisher": "lovits",
  "displayName": "Hot100 ACM",
  "description": "在 VS Code 中练习 Hot100：ACM 与核心代码模式、题库组合筛选、本机测试、收藏笔记与间隔复习。",
  "version": "0.2.89",
  "icon": "resources/taffy-marketplace.png",
  "engines": {
    "vscode": "^1.107.0",
    "node": ">=20"
  },
  "categories": [
    "Education",
    "Programming Languages"
  ],
  "keywords": [
    "leetcode",
    "hot-100",
    "acm",
    "algorithm",
    "interview",
    "python",
    "cpp",
    "刷题"
  ],
  "galleryBanner": {
    "color": "#1A1A2E",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lovits/hot100-acm.git",
    "directory": "vscode-extension"
  },
  "homepage": "https://github.com/lovits/hot100-acm/tree/main/vscode-extension",
  "bugs": {
    "url": "https://github.com/lovits/hot100-acm/issues"
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hot100Pro.configurePrivateSync",
        "title": "Hot100: 配置个人私网同步"
      },
      {
        "command": "hot100Pro.syncPrivate",
        "title": "Hot100: 立即同步个人数据"
      },
      {
        "command": "hot100Pro.syncConflicts",
        "title": "Hot100: 查看同步冲突"
      },
      {
        "command": "hot100Pro.login",
        "title": "LeetCode: 登录",
        "icon": "$(account)"
      },
      {
        "command": "hot100Pro.logout",
        "title": "LeetCode: 退出登录"
      },
      {
        "command": "hot100Pro.refreshList",
        "title": "刷新列表",
        "icon": "$(refresh)"
      },
      {
        "command": "hot100Pro.submit",
        "title": "LeetCode: 提交代码",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "hot100Pro.test",
        "title": "LeetCode: 运行测试",
        "icon": "$(play)"
      },
      {
        "command": "hot100Pro.debug",
        "title": "LeetCode: 本地调试",
        "icon": "$(debug-alt)"
      },
      {
        "command": "hot100Pro.runDebug",
        "title": "LeetCode: 运行当前文件",
        "icon": "$(run)"
      },
      {
        "command": "hot100Pro.viewSolution",
        "title": "LeetCode: 查看题解",
        "icon": "$(book)"
      },
      {
        "command": "hot100Pro.showRawJudge",
        "title": "LeetCode: 查看最近一次原始判题响应"
      },
      {
        "command": "hot100Pro.debugFailedCase",
        "title": "LeetCode: 用判题失败用例本地调试"
      },
      {
        "command": "hot100Pro.newSolutionFile",
        "title": "LeetCode: 用其他语言新建题解文件",
        "icon": "$(new-file)"
      },
      {
        "command": "hot100Pro.customTest",
        "title": "LeetCode: 用自定义用例测试",
        "icon": "$(beaker)"
      },
      {
        "command": "hot100Pro.setStatusFilter",
        "title": "侧栏状态筛选：未做/已解决/尝试过"
      },
      {
        "command": "hot100Pro.setGroupBy",
        "title": "侧栏分组方式：按专题/按难度/按题号/高频优先",
        "icon": "$(list-ordered)"
      },
      {
        "command": "hot100Pro.searchProblem",
        "title": "LeetCode: 搜索题目（题号/标题/分类）",
        "icon": "$(search)"
      },
      {
        "command": "hot100Pro.randomProblem",
        "title": "LeetCode: 随机抽题",
        "icon": "$(sparkle)"
      },
      {
        "command": "hot100Pro.dailyQuestion",
        "title": "LeetCode: 每日一题"
      },
      {
        "command": "hot100Pro.viewSubmissions",
        "title": "LeetCode: 查看提交历史",
        "description": "查看当前题最近 20 条提交，可把云端提交的代码恢复到本地（跨设备同步）"
      },
      {
        "command": "hot100Pro.nextProblem",
        "title": "LeetCode: 下一题"
      },
      {
        "command": "hot100Pro.setDailyGoal",
        "title": "LeetCode: 设置每日刷题目标"
      },
      {
        "command": "hot100Pro.toggleFavorite",
        "title": "LeetCode: 收藏/取消收藏题目（本地）",
        "icon": "$(star)"
      },
      {
        "command": "hot100Pro.openNote",
        "title": "LeetCode: 打开题目笔记",
        "icon": "$(note)"
      },
      {
        "command": "hot100Pro.reviewWrong",
        "title": "LeetCode: 复习错题（到期的优先）"
      },
      {
        "command": "hot100Pro.clearWrongQueue",
        "title": "清空错题回顾队列"
      },
      {
        "command": "hot100Pro.usageGuide",
        "title": "Hot100 ACM: 运行与提交说明"
      },
      {
        "command": "hot100Pro.filter",
        "title": "Hot100 ACM: 筛选题库",
        "icon": "$(filter)"
      },
      {
        "command": "hot100Pro.clearFilters",
        "title": "Hot100 ACM: 清空组合筛选"
      },
      {
        "command": "hot100Pro.studyPlan",
        "title": "Hot100 ACM: 学习计划与日历"
      },
      {
        "command": "hot100Pro.resetPlan",
        "title": "Hot100 ACM: 重置学习计划"
      },
      {
        "command": "hot100Pro.configurePlan",
        "title": "Hot100 ACM: 修改学习目标与间隔"
      },
      {
        "command": "hot100Pro.localRun",
        "title": "Hot100 ACM: 本机运行并评测",
        "icon": "$(play)"
      },
      {
        "command": "hot100Pro.localSubmit",
        "title": "Hot100 ACM: 本机评测全部用例",
        "icon": "$(check-all)"
      },
      {
        "command": "hot100Pro.confirmReview",
        "title": "Hot100 ACM: 确认复习完成"
      },
      {
        "command": "hot100Pro.open",
        "title": "Hot100 ACM: 打开刷题台"
      },
      {
        "command": "hot100Pro.localCustom",
        "title": "Hot100 ACM: 本机自定义用例",
        "icon": "$(beaker)"
      },
      {
        "command": "hot100Pro.testCases",
        "title": "Hot100 ACM: 打开测试用例"
      },
      {
        "command": "hot100Pro.caseRunAll",
        "title": "Hot100 ACM: 运行全部测试用例"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hot100-pro-enhanced",
          "title": "Hot100 ACM",
          "icon": "resources/taffy-sidebar.svg"
        }
      ],
      "panel": [
        {
          "id": "hot100-tests",
          "title": "Hot100 测试",
          "icon": "$(beaker)"
        }
      ]
    },
    "views": {
      "hot100-pro-enhanced": [
        {
          "id": "hot100-pro-questions",
          "name": "Hot100 ACM",
          "contextualTitle": "Hot100 ACM",
          "icon": "resources/taffy-sidebar.svg"
        }
      ],
      "hot100-tests": [
        {
          "id": "hot100-test-cases",
          "name": "测试用例",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "hot100Pro.filter",
          "when": "view == hot100-pro-questions",
          "group": "navigation@0"
        },
        {
          "command": "hot100Pro.login",
          "group": "navigation@1",
          "when": "view == hot100-pro-questions"
        },
        {
          "command": "hot100Pro.refreshList",
          "group": "navigation@2",
          "when": "view == hot100-pro-questions"
        },
        {
          "command": "hot100Pro.setGroupBy",
          "group": "navigation@3",
          "when": "view == hot100-pro-questions"
        },
        {
          "command": "hot100Pro.searchProblem",
          "group": "navigation@4",
          "when": "view == hot100-pro-questions"
        },
        {
          "command": "hot100Pro.randomProblem",
          "group": "navigation@5",
          "when": "view == hot100-pro-questions"
        }
      ],
      "view/item/context": [
        {
          "command": "hot100Pro.openNote",
          "group": "inline@1",
          "when": "view == hot100-pro-questions && viewItem == question"
        },
        {
          "command": "hot100Pro.toggleFavorite",
          "group": "inline@2",
          "when": "view == hot100-pro-questions && viewItem == question"
        }
      ],
      "editor/title": [
        {
          "command": "hot100Pro.localSubmit",
          "when": "resourcePath =~ /leetcode/ && !(resourcePath =~ /notes/)",
          "group": "navigation@0"
        },
        {
          "command": "hot100Pro.localCustom",
          "when": "resourcePath =~ /leetcode/ && !(resourcePath =~ /notes/)",
          "group": "navigation@1"
        },
        {
          "command": "hot100Pro.runDebug",
          "group": "navigation@0",
          "when": "resourcePath =~ /leetcode/ && !(resourcePath =~ /notes/)"
        },
        {
          "command": "hot100Pro.debug",
          "group": "navigation@1",
          "when": "resourcePath =~ /leetcode/ && !(resourcePath =~ /notes/) && !hot100Pro.acmActive"
        },
        {
          "command": "hot100Pro.test",
          "group": "navigation@2",
          "when": "resourcePath =~ /leetcode/ && !(resourcePath =~ /notes/)"
        },
        {
          "command": "hot100Pro.submit",
          "group": "navigation@3",
          "when": "resourcePath =~ /leetcode/ && !(resourcePath =~ /notes/) && !hot100Pro.acmActive"
        },
        {
          "command": "hot100Pro.customTest",
          "group": "navigation@4",
          "when": "resourcePath =~ /customcase_/"
        }
      ]
    },
    "configuration": {
      "title": "Hot100 ACM",
      "properties": {
        "hot100Pro.dailyGoal": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 100,
          "description": "每日刷题目标（每天提交通过的题数），侧栏刷题统计中展示今日进度"
        },
        "hot100Pro.reviewLimit": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "description": "每日复习数量上限，未完成任务继续保留。"
        },
        "hot100Pro.reviewIntervals": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          },
          "default": [
            1,
            2,
            4,
            7,
            15,
            30
          ],
          "description": "首次完成后的复习日期（天），递增；逾期完成后顺延后续阶段。"
        },
        "hot100Pro.pythonPath": {
          "type": "string",
          "default": "",
          "description": "留空时读取 VS Code 当前环境或编译配置，最后回退系统 PATH。"
        },
        "hot100Pro.cCompilerPath": {
          "type": "string",
          "default": "",
          "description": "留空时读取 VS Code 当前环境或编译配置，最后回退系统 PATH。"
        },
        "hot100Pro.cppCompilerPath": {
          "type": "string",
          "default": "",
          "description": "留空时读取 VS Code 当前环境或编译配置，最后回退系统 PATH。"
        }
      }
    },
    "keybindings": [
      {
        "command": "hot100Pro.test",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorTextFocus && resourcePath =~ /leetcode/"
      },
      {
        "command": "hot100Pro.submit",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "editorTextFocus && resourcePath =~ /leetcode/"
      },
      {
        "command": "hot100Pro.nextProblem",
        "key": "ctrl+alt+right",
        "mac": "cmd+alt+right",
        "when": "editorTextFocus && resourcePath =~ /leetcode/"
      },
      {
        "command": "hot100Pro.searchProblem",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      },
      {
        "command": "hot100Pro.dailyQuestion",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      },
      {
        "command": "hot100Pro.randomProblem",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      },
      {
        "command": "hot100Pro.reviewWrong",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w"
      },
      {
        "command": "hot100Pro.openNote",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "editorTextFocus && resourcePath =~ /leetcode/"
      },
      {
        "command": "hot100Pro.toggleFavorite",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus && resourcePath =~ /leetcode/"
      },
      {
        "command": "hot100Pro.testCases",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u"
      },
      {
        "command": "hot100Pro.caseRunAll",
        "key": "ctrl+alt+shift+t",
        "mac": "cmd+alt+shift+t"
      },
      {
        "command": "hot100Pro.localRun",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus && resourcePath =~ /leetcode/"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node scripts/private-package-guard.cjs && npm run compile",
    "precompile": "node scripts/sync-shared.cjs",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "node --test \"out/unit/*.unit.test.js\" test/network-retry-test.cjs ../tests/native-static-fallback.test.cjs",
    "release": "node scripts/release.mjs",
    "test:judge": "node test/engine-test.js python3 && node test/engine-test.js cpp && node test/c-core-test.js && node test/c-acm-test.js && node test/c-negative-test.js",
    "package": "npx @vscode/vsce@3.7.0 package --no-dependencies --readme-path MARKETPLACE.md"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "dependencies": {
    "playwright-core": "1.63.0"
  },
  "packageManager": "pnpm@11.25.0",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "可查看题目；执行代码须信任工作区。"
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "badges": [
    {
      "url": "https://img.shields.io/badge/license-MIT-blue",
      "href": "https://github.com/lovits/hot100-acm/blob/main/vscode-extension/LICENSE",
      "description": "MIT License"
    },
    {
      "url": "https://img.shields.io/badge/VS_Code-Marketplace-007ACC",
      "href": "https://marketplace.visualstudio.com/items?itemName=lovits.hot100-practice",
      "description": "VS Code Marketplace"
    }
  ]
}
